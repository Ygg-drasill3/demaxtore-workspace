// =============================================================================
// DeMaxtore — Sprint 1 Prisma Schema (REFERENCE)
// Stack: Node.js + Express + PostgreSQL + Prisma
// Scope: ONLY the minimum models required for Sprint 1 (auth, RBAC, notifications,
//        workspace routing skeleton, socket.io preparation).
// Future modules (RFQ, Quotation, PO, FreightIQ, Inspection, Shipment) are
// intentionally NOT modelled here. They plug into the workspace skeleton in
// later sprints.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums (frozen — do not extend in Sprint 1)
// -----------------------------------------------------------------------------

enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum WorkspaceType {
  STANDARD_RFQ_WORKSPACE
  COMMODITYBID_WORKSPACE
  ORDER_WORKSPACE
}

// Generic, workspace-agnostic placeholder state. In Sprint 2+ each workspace
// type will expand its own state machine. Sprint 1 only needs a "lives"
// container so routing/socket subscriptions can exist.
enum WorkspaceState {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ParticipantRole {
  OWNER          // creator of the workspace (e.g. Buyer for RFQ)
  COUNTERPARTY   // invited supplier / counterparty
  OPERATOR       // DeMaxtore admin / ops
  OBSERVER       // read-only stakeholder
}

// -----------------------------------------------------------------------------
// Users & Auth
// -----------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String
  role          Role
  isActive      Boolean  @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResets      PasswordResetToken[]
  notifications       Notification[]
  workspaceParticipations WorkspaceParticipant[]
  createdWorkspaces   Workspace[] @relation("WorkspaceCreator")

  @@index([role])
  @@map("users")
}

// One row per issued refresh token. Allows server-side revocation and
// device-level session management. The token value is stored hashed (never
// plain) to mitigate DB exfiltration.
model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") // sha256 of the JWT
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?  @map("replaced_by") @db.Uuid     // refresh-token rotation chain
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Brute-force throttling. Optional but recommended for Sprint 1.
model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  identifier  String   // e.g. `${ip}:${email}`
  succeeded   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

// -----------------------------------------------------------------------------
// Workspaces (routing skeleton only — Sprint 1)
// -----------------------------------------------------------------------------
// Sprint 1 needs a real row to exist for /workspace/:type/:id so that
// participants can be authorized and socket.io rooms can be subscribed.
// NO business fields. Each WorkspaceType in Sprint 2+ will get its own
// satellite table (e.g. RfqDetails, CommodityBidDetails, OrderDetails) related
// 1:1 to Workspace.id.

model Workspace {
  id              String         @id @default(uuid()) @db.Uuid
  // Stable, human-friendly external id (e.g. "WS-RFQ-2026-00012")
  externalRef     String         @unique @map("external_ref")
  type            WorkspaceType
  state           WorkspaceState @default(DRAFT)
  createdById     String         @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  createdBy       User           @relation("WorkspaceCreator", fields: [createdById], references: [id])
  participants    WorkspaceParticipant[]
  timelineEvents  TimelineEvent[]

  @@index([type, state])
  @@index([createdById])
  @@map("workspaces")
}

// Who can see / interact with a workspace, and in what capacity.
// All RBAC checks for workspace-scoped endpoints go through this table.
model WorkspaceParticipant {
  id            String          @id @default(uuid()) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  participantRole ParticipantRole @map("participant_role")
  joinedAt      DateTime        @default(now()) @map("joined_at")

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_participants")
}

// Append-only event log per workspace.  Sprint 1 only seeds 1 event
// ("workspace.created") so the Timeline panel can render something.
model TimelineEvent {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  eventType     String   @map("event_type")  // e.g. "workspace.created"
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  payload       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("timeline_events")
}

// -----------------------------------------------------------------------------
// Notifications
// -----------------------------------------------------------------------------

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  // null userId  -> role-broadcast (delivered to every user with `role`)
  userId      String?          @map("user_id") @db.Uuid
  role        Role?            // role-broadcast target
  type        NotificationType
  title       String
  message     String
  link        String?          // optional deep-link, e.g. /workspace/rfq/:id
  metadata    Json             @default("{}")
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([role, createdAt])
  @@map("notifications")
}
