{
  "name": "@dmx/contracts",
  "version": "0.2.0",
  "private": true,
  "description": "DeMaxtore shared contracts — FSM, Zod schemas, DTOs, socket events. Single source of truth for backend + frontend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build":     "tsc && node scripts/fix-esm-imports.mjs",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest":     "^2.0.5"
  }
}
