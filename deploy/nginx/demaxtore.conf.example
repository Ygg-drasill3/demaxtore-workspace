# DeMaxtore — recommended production edge (Sprint 9B)
# Copy to /etc/nginx/sites-available/ and adjust server_name, SSL paths, upstream ports.
# DO NOT deploy automatically from the repository.

  upstream dmx_api {
  least_conn;
  server 127.0.0.1:3001 max_fails=3 fail_timeout=30s;
  # server 127.0.0.1:8002 max_fails=3 fail_timeout=30s;
  keepalive 64;
}

upstream dmx_frontend {
  server 127.0.0.1:3000;
  keepalive 16;
}

server {
  listen 443 ssl http2;
  server_name app.example.com;

  ssl_certificate     /etc/ssl/certs/demaxtore.crt;
  ssl_certificate_key /etc/ssl/private/demaxtore.key;

  client_max_body_size 26M;
  gzip on;
  gzip_types application/json text/css application/javascript;

  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://demaxtore.com https://www.demaxtore.com https://freightiq.demaxtore.com https://commoditybid.demaxtore.com wss: ws:; frame-src 'self' https://demaxtore.com https://www.demaxtore.com https://freightiq.demaxtore.com https://commoditybid.demaxtore.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" always;

  location /socket.io/ {
    proxy_pass http://dmx_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /api/ {
    proxy_pass http://dmx_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
  }

  location / {
    proxy_pass http://dmx_frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
