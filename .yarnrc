# A maplibre transitive dep (@mapbox/jsonlint-lines-primitives) declares node >= 22,
# which aborts the whole install on the node 20 baseline this repo targets. The package
# itself runs fine on node 20, so engine checks are advisory here.
--install.ignore-engines true
--add.ignore-engines true

# The app servers export NODE_ENV=production, which makes yarn drop every
# devDependency AND rewrite yarn.lock without them. Installs must stay complete
# regardless of the ambient NODE_ENV; use `yarn install --production` deliberately
# when building a runtime-only tree.
--install.production false
