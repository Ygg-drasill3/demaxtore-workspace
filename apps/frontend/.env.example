# DeMaxtore Frontend env (Vite)
# Copy to .env.local for local development.

# Development — Vite dev server proxies /api → backend :3001
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_APP_NAME=DeMaxtore

# External panel embeds (optional overrides)
VITE_COMMODITYBID_PANEL_URL=https://commoditybid.demaxtore.com/panel
VITE_COMMODITYBID_CREATE_PATH=/productionRequests/create
VITE_COMMODITYBID_LIST_PATH=/productionRequests
VITE_FREIGHTIQ_PANEL_URL=https://freightiq.demaxtore.com
VITE_CATALOG_RFQ_URL=https://demaxtore.com/rfq
