# DeMaxtore backend env — local development defaults
# Phase A scaffolding. Modify per environment.

DATABASE_URL=postgresql://dmx:dmx_dev@127.0.0.1:5432/dmx?schema=public
JWT_SECRET=change-me-dev-only-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-dev-only-jwt-refresh-min-32
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:3000
PORT=3001
APP_BASE_URL=http://localhost:3000
STORAGE_DIR=./.data/uploads
LOG_LEVEL=info
NODE_ENV=development

# Sprint 4B — Maritime tracking (manual = dev/E2E; maritime_api = external HTTP)
TRACKING_PROVIDER=manual
TRACKING_API_KEY=
TRACKING_BASE_URL=
TRACKING_SYNC_INTERVAL_MS=3600000

# Passwordless Workspace Access™ (signed magic links)
PASSWORDLESS_ACCESS_SECRET=change-me-passwordless-access-secret-min-32
PASSWORDLESS_ACCESS_DEFAULT_TTL_MIN=30

# CommodityBid external panel (iframe SSO embed)
COMMODITYBID_PANEL_URL=https://commoditybid.demaxtore.com
COMMODITYBID_CREATE_PATH=/productionRequests/create
COMMODITYBID_LIST_PATH=/productionRequests

# FreightIQ external panel (iframe SSO embed)
FREIGHTIQ_PANEL_URL=https://freightiq.demaxtore.com
FREIGHTIQ_API_URL=http://127.0.0.1:8000

# WhatsApp Cloud API — Meta webhook → GET/POST /api/webhooks/whatsapp
# WhatsApp Notification Bridge™
WHATSAPP_BRIDGE_ENABLED=true
WHATSAPP_BRIDGE_PROVIDER=meta_cloud
WHATSAPP_BRIDGE_RETRY_INTERVAL_MS=60000

# Email Notification Bridge™
EMAIL_BRIDGE_ENABLED=true
EMAIL_BRIDGE_PROVIDER=resend
EMAIL_BRIDGE_RETRY_INTERVAL_MS=60000
EMAIL_BRIDGE_OPEN_TRACKING_ENABLED=true
API_PUBLIC_BASE_URL=https://workspace.demaxtore.com/api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=demaxtore_whatsapp_2026
# Meta Developer Console → App Settings → Basic → App Secret (NOT the access token)
WHATSAPP_APP_SECRET=
WHATSAPP_META_APP_ID=
WHATSAPP_API_VERSION=v25.0

# demaxtore.com katalog RFQ → workspace ingest (X-DeMaxtore-Catalog-RFQ-Token)
CATALOG_RFQ_INGEST_TOKEN=change-me-catalog-rfq-ingest-token
CATALOG_RFQ_FALLBACK_BUYER_EMAIL=buyer@dema.test

# ── Faz 1 webhooks (generate: ../../scripts/generate-secret.sh — min 32 chars / 64 hex) ──
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_ENFORCE_HMAC=true
CARRIER_WEBHOOK_SECRET=
CARRIER_WEBHOOK_ENFORCE_HMAC=true

# ── Faz 2–6 feature flags (default OFF — enable per rollout runbook) ─────────
FSM_ORCHESTRATOR_ENABLED=false
FSM_ORCHESTRATOR_SHADOW_MODE=true
FSM_ORCHESTRATOR_AUTO_APPLY=false
# ── Online payment collection (PAY-001) ───────────────────────────────────────
# ONLINE_PAYMENTS_ENABLED=true requires a real PAYMENT_PROVIDER (not stub).
ONLINE_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=stub

# ── Enterprise production safety gates (CFG-001) ─────────────────────────────
# Required true in NODE_ENV=production or the server will refuse to start.
PAYMENT_GATES_ENABLED=false
CARRIER_AUTO_TRANSITION_ENABLED=false
INCOTERMS_PRECONDITIONS_ENABLED=false
EXCEPTION_ENGINE_V2_ENABLED=false
RBAC_EXPANDED_ROLES_ENABLED=false

# Email — set RESEND_API_KEY + EMAIL_PROVIDER=resend for production mail delivery
OUTBOUND_MESSAGING_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
