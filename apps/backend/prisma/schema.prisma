/// Sprint 37 — Turkey Customs Case (country-specific; not global Shipment FSM).
/// MVP: one non-cancelled case per shipment. DeMaxtore orchestrates; does not file government declarations.
enum CustomsCaseStatus {
  DRAFT
  PREPARING
  READY_FOR_BROKER
  BROKER_REVIEW
  DECLARATION_PREPARING
  DECLARATION_FILED
  CUSTOMS_PROCESSING
  CLEARANCE_PENDING
  CLEARED
  HOLD
  CANCELLED
}

enum CustomsStatusSource {
  BUYER
  CUSTOMS_BROKER
  DEMAXTORE_OPERATIONS
  SYSTEM_DERIVED
}

enum CustomsHoldCategory {
  DOCUMENT
  CLASSIFICATION
  BROKER_REVIEW
  CUSTOMS_QUERY
  PAYMENT
  OTHER
}

model CustomsCase {
  id                    String            @id @default(uuid()) @db.Uuid
  organisationId        String            @map("organisation_id") @db.Uuid
  shipmentWorkspaceId   String            @map("shipment_workspace_id") @db.Uuid
  orderWorkspaceId      String            @map("order_workspace_id") @db.Uuid
  status                CustomsCaseStatus @default(DRAFT)
  readinessStatus       String            @default("NOT_READY") @map("readiness_status")
  destinationCountryCode String?          @map("destination_country_code")
  brokerUserId          String?           @map("broker_user_id") @db.Uuid
  brokerAssignmentId    String?           @map("broker_assignment_id") @db.Uuid
  declarationReference  String?           @map("declaration_reference")
  declarationDate       DateTime?         @map("declaration_date")
  customsOffice         String?           @map("customs_office")
  statusSource          CustomsStatusSource @default(SYSTEM_DERIVED) @map("status_source")
  holdCategory          CustomsHoldCategory? @map("hold_category")
  holdReason            String?           @map("hold_reason") @db.Text
  holdAt                DateTime?         @map("hold_at")
  previousStatusBeforeHold CustomsCaseStatus? @map("previous_status_before_hold")
  clearedAt             DateTime?         @map("cleared_at")
  cancelledAt           DateTime?         @map("cancelled_at")
  cancelReason          String?           @map("cancel_reason") @db.Text
  notes                 String?           @db.Text
  createdById           String            @map("created_by_id") @db.Uuid
  updatedById           String?           @map("updated_by_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  shipmentWorkspace ShipmentWorkspace  @relation(fields: [shipmentWorkspaceId], references: [workspaceId], onDelete: Cascade)
  events            CustomsCaseEvent[]
  dutyTaxCalculations DutyTaxCalculation[]

  @@unique([shipmentWorkspaceId])
  @@index([organisationId, status])
  @@index([orderWorkspaceId])
  @@index([brokerUserId])
  @@index([readinessStatus])
  @@map("customs_cases")
}

model CustomsCaseEvent {
  id          String   @id @default(uuid()) @db.Uuid
  customsCaseId String @map("customs_case_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  source      CustomsStatusSource
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  reason      String?  @db.Text
  payload     Json     @default("{}")
