model BulkContainerLine {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  catalogProductId   String    @map("catalog_product_id") @db.Uuid
  packingTypeId      String    @map("packing_type_id") @db.Uuid
  specValues         Json      @default("{}") @map("spec_values")
  quantityMt         Decimal   @map("quantity_mt") @db.Decimal(10, 3)
  sortOrder          Int       @default(0) @map("sort_order")
  indicativeUnitLow  Decimal?  @map("indicative_unit_low") @db.Decimal(18, 4)
  indicativeUnitHigh Decimal?  @map("indicative_unit_high") @db.Decimal(18, 4)
  removedAt          DateTime? @map("removed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  catalogProduct      BulkCatalogProduct     @relation(fields: [catalogProductId], references: [id])
  packingType         PackingType            @relation(fields: [packingTypeId], references: [id])
  procurementQuotes   BcProcurementQuote[]
  offerLines          BcOfferLine[]
  supplierAllocations BcSupplierAllocation[]

  @@index([workspaceId, removedAt])
