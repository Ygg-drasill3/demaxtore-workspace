/// SPR-30-04 — planned / estimated / actual milestone planning (does not replace FSM)
model ShipmentMilestone {
  id                  String    @id @default(uuid()) @db.Uuid
  shipmentWorkspaceId String    @map("shipment_workspace_id") @db.Uuid
  type                String
  plannedAt           DateTime? @map("planned_at")
  estimatedAt         DateTime? @map("estimated_at")
  actualAt            DateTime? @map("actual_at")
  status              String    @default("PENDING")
  delayMinutes        Int?      @map("delay_minutes")
  sequence            Int
