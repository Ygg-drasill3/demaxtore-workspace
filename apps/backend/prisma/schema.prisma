// =============================================================================
// DeMaxtore — unified Prisma schema (Integration Hardening Sprint · Phase B)
// Merges Sprint 1 (auth, sessions, notifications) + Sprint 2 (RFQ workspace,
// timeline, clarifications, audit) + Sprint 2.5 (supplier-activity, telemetry,
// idempotency, structured quotations + line items, attachment versioning).
// FSM is enforced at the app layer via @dmx/contracts and a SQL trigger.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────────
enum Role {
  BUYER
  SUPPLIER
  ADMIN
  SALES_CONTROL
  SUPER_ADMIN
  OPS_MANAGER
  LOGISTICS_OPERATOR
  FINANCE_OPERATOR
  DOCUMENT_CONTROLLER
  FORWARDER
}

enum WorkspaceType {
  RFQ
  COMMODITYBID
  ORDER
  SHIPMENT
  MIXED_CONTAINER
  BULK_CONTAINER
}

enum ParticipantRole {
  OWNER
  COUNTERPARTY
  OPERATOR
  OBSERVER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum QuotationStatus {
  SUBMITTED
  REVISED
  WITHDRAWN
}

enum ClarificationVisibility {
  ALL
  ADMIN_ONLY
}

enum SupplierStage {
  INVITED
  VIEWED
  RETURNED
  QUOTED
  DECLINED
}

// ── Identity & sessions ─────────────────────────────────────────────────────
model Organisation {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  kind          String // BUYER_ORG | SUPPLIER_ORG | DEMAXTORE
  location      String?
  verifiedSince DateTime? @map("verified_since")
  pastPoCount   Int       @default(0) @map("past_po_count")
  createdAt     DateTime  @default(now()) @map("created_at")

  users            User[]
  accountOwnership AccountOwnership?

  @@map("organisations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  passwordHash   String   @map("password_hash")
  displayName    String   @map("display_name")
  role           Role
  organisationId String?  @map("organisation_id") @db.Uuid
  avatarUrl      String?  @map("avatar_url")
  whatsappPhone  String?  @map("whatsapp_phone")
  phoneNumber              String?   @map("phone_number")
  phoneVerificationStatus  String?   @map("phone_verification_status")
  phoneVerifiedAt          DateTime? @map("phone_verified_at")
  phoneVerifiedBy          String?   @map("phone_verified_by") @db.Uuid
  googleId       String?  @unique @map("google_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation        Organisation?              @relation(fields: [organisationId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  passwordlessAccessTokens PasswordlessAccessToken[]
  workspacesCreated   Workspace[]                @relation("WorkspaceCreator")
  participantOf       WorkspaceParticipant[]
  timelineActions     TimelineEvent[]
  notifications       Notification[]
  telemetryEvents     TelemetryEvent[]
  idempotencyKeys     IdempotencyKey[]
  operationsAccounts  AccountOwnership[]         @relation("AccountOperationsOwner")
  salesAccounts       AccountOwnership[]         @relation("AccountSalesOwner")
  backupVerifications BackupVerificationRecord[]
  onboardingProgress  UserOnboardingProgress?
  phoneVerificationRequests PhoneVerificationRequest[]

  @@index([role])
  @@index([phoneVerificationStatus])
  @@map("users")
}

model PhoneVerificationRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  phone       String
  status      String    @default("PENDING")
  notes       String?   @db.Text
  submittedAt DateTime  @default(now()) @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  approvedBy  String?   @map("approved_by") @db.Uuid
  rejectedAt  DateTime? @map("rejected_at")
  rejectedBy  String?   @map("rejected_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([userId, submittedAt])
  @@map("phone_verification_requests")
}

model AccountOwnership {
  organisationId   String   @id @map("organisation_id") @db.Uuid
  operationsUserId String?  @map("operations_user_id") @db.Uuid
  salesUserId      String?  @map("sales_user_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at")

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  operationsUser User?        @relation("AccountOperationsOwner", fields: [operationsUserId], references: [id], onDelete: SetNull)
  salesUser      User?        @relation("AccountSalesOwner", fields: [salesUserId], references: [id], onDelete: SetNull)

  @@index([operationsUserId])
  @@index([salesUserId])
  @@map("account_ownership")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ── Passwordless Workspace Access™ ──────────────────────────────────────────
model PasswordlessAccessToken {
  id               String    @id @default(uuid()) @db.Uuid
  jti              String    @unique
  tokenHash        String    @unique @map("token_hash")
  userId           String    @map("user_id") @db.Uuid
  workspaceType    String    @map("workspace_type")
  workspaceId      String    @map("workspace_id") @db.Uuid
  conversationId   String    @map("conversation_id") @db.Uuid
  auditWorkspaceId String    @map("audit_workspace_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  singleUse        Boolean   @default(true) @map("single_use")
  emailDeliveryId  String?   @map("email_delivery_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs PasswordlessAccessLog[]

  @@index([userId, workspaceId])
  @@index([expiresAt])
  @@map("passwordless_access_tokens")
}

model PasswordlessAccessLog {
  id             String   @id @default(uuid()) @db.Uuid
  tokenId        String?  @map("token_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  workspaceType  String   @map("workspace_type")
  workspaceId    String   @map("workspace_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  success        Boolean
  failureReason  String?  @map("failure_reason")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  token PasswordlessAccessToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("passwordless_access_logs")
}

// ── Workspaces ──────────────────────────────────────────────────────────────
model Workspace {
  id          String        @id @default(uuid()) @db.Uuid
  externalRef String        @unique @map("external_ref")
  type        WorkspaceType
  state       String
  currency    String?
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  deadlineAt                 DateTime? @map("deadline_at")
  deadlineExtensionCount     Int       @default(0) @map("deadline_extension_count")
  lastSlaReminderAt          DateTime? @map("last_sla_reminder_at")
  deadlineExtensionTotalDays Int       @default(0) @map("deadline_extension_total_days")

  proformaRequestedAt   DateTime? @map("proforma_requested_at")
  proformaSlaDeadlineAt DateTime? @map("proforma_sla_deadline_at")

  spawnedFromId   String?     @map("spawned_from_id") @db.Uuid
  spawnedFrom     Workspace?  @relation("WorkspaceSpawn", fields: [spawnedFromId], references: [id])
  spawnedChildren Workspace[] @relation("WorkspaceSpawn")
  trashedAt       DateTime?   @map("trashed_at")
  metadata        Json        @default("{}")

  createdBy               User                       @relation("WorkspaceCreator", fields: [createdById], references: [id])
  participants            WorkspaceParticipant[]
  timelineEvents          TimelineEvent[]
  rfqDetails              RfqDetails?
  rfqLineItems            RfqLineItem[]
  supplierLineScopes      SupplierLineScope[]
  rfqAttachments          RfqAttachment[]
  supplierAssignments     SupplierAssignment[]
  clarificationThread     ClarificationThread?
  auditLogs               AuditLog[]
  notifications           Notification[]
  quotations              Quotation[]
  supplierActivity        SupplierActivityLog[]
  commodityBidDetails     CommodityBidDetails?
  commodityBidLots        CommodityBidLot[]
  commodityBidInvitations CommodityBidInvitation[]
  commodityBidSubmissions CommodityBidSubmission[]
  commodityBidAwards      CommodityBidAward[]
  commodityBidBidEvents   CommodityBidBidEvent[]
  orderWorkspace          OrderWorkspace?
  orderDocuments          OrderDocument[]
  orderStatusUpdates      OrderStatusUpdate[]
  shipmentWorkspace       ShipmentWorkspace?
  shipmentDocuments       ShipmentDocument[]
  shipmentStatusUpdates   ShipmentStatusUpdate[]
  shipmentExceptions      ShipmentException[]
  controlTowerAlerts      ControlTowerAlert[]
  trackingSnapshots       ShipmentTrackingSnapshot[]
  trackingEvents          ShipmentTrackingEvent[]
  freightRequests         FreightRequest[]
  freightEstimates        FreightEstimate[]
  cargoReadyForecasts     CargoReadyForecast[]
  freightBookings         FreightBooking[]
  carrierOptions          CarrierOption[]
  mixedContainerDetails   MixedContainerDetails?
  mcProcurementStatusHistory McProcurementStatusHistory[]
  mcOrganizationStatusHistory McOrganizationStatusHistory[]
  mcOrganizationEvents        McOrganizationEvent[]
  mcInternalNotes         McInternalNote[]
  containerLines          ContainerLine[]
  mcProcurementQuotes     McProcurementQuote[]
  mcContainerOffers       McContainerOffer[]
  mcRevisionRequests      McRevisionRequest[]
  mcSupplierAllocations   McSupplierAllocation[]
  mcSupplierProformas     McSupplierProforma[]
  mcPaymentRecords        McPaymentRecord[]
  mcMasterOrders          McMasterOrder[]
  mcOrderLinks            McOrderLink[]
  bulkContainerDetails    BulkContainerDetails?
  bulkContainerLines      BulkContainerLine[]
  bcProcurementQuotes     BcProcurementQuote[]
  bcContainerOffers       BcContainerOffer[]
  bcRevisionRequests      BcRevisionRequest[]
  bcSupplierAllocations   BcSupplierAllocation[]
  bcSupplierProformas     BcSupplierProforma[]
  bcPaymentRecords        BcPaymentRecord[]
  bcMasterOrders          BcMasterOrder[]
  bcOrderLinks            BcOrderLink[]
  mcOrderLinksAsSupplier  McOrderLink[]              @relation("SupplierOrderLink")
  bcOrderLinksAsSupplier  BcOrderLink[]              @relation("BcSupplierOrderLink")
  tradeTimelineEvents     TradeTimelineEvent[]

  @@index([type, state])
  @@index([type, state, deadlineAt])
  @@index([type, state, updatedAt])
  @@index([type, state, proformaSlaDeadlineAt])
  @@index([type, createdAt])
  @@index([type, trashedAt, createdAt])
  @@index([createdById])
  @@index([spawnedFromId])
  @@map("workspaces")
}

model WorkspaceParticipant {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  participantRole ParticipantRole
  joinedAt        DateTime        @default(now()) @map("joined_at")
  leftAt          DateTime?       @map("left_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, participantRole])
  @@index([workspaceId])
  @@index([userId, leftAt])
  @@map("workspace_participants")
}

model TimelineEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  eventType   String   @map("event_type")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("timeline_events")
}

// ── RFQ details (carried verbatim from partial schema) ──────────────────────
model RfqDetails {
  id                     String    @id @default(uuid()) @db.Uuid
  workspaceId            String    @unique @map("workspace_id") @db.Uuid
  title                  String
  productCategory        String    @map("product_category")
  productDescription     String    @map("product_description") @db.Text
  targetMarket           String    @map("target_market")
  incoterm               String
  lastRejectionReason    String?   @map("last_rejection_reason")
  lastRejectedAt         DateTime? @map("last_rejected_at")
  selectedSupplierUserId String?   @map("selected_supplier_user_id") @db.Uuid
  selectedQuotationId    String?   @map("selected_quotation_id") @db.Uuid
  selectionRationale     String?   @map("selection_rationale")
  proformaFileUrl        String?   @map("proforma_file_url")
  proformaSubmittedAt    DateTime? @map("proforma_submitted_at")
  proformaApprovedAt     DateTime? @map("proforma_approved_at")
  poNumber               String?   @unique @map("po_number")
  poIssuedAt             DateTime? @map("po_issued_at")
  poFileUrl              String?   @map("po_file_url")
  procurementMethod      String?   @map("procurement_method")
  linkedCommoditybidId   String?   @map("linked_commoditybid_id") @db.Uuid
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([selectedSupplierUserId])
  @@map("rfq_details")
}

model RfqLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  position    Int
  description String   @db.Text
  quantity    Decimal  @db.Decimal(18, 4)
  uom         String
  targetPrice Decimal? @map("target_price") @db.Decimal(18, 4)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierLineScopes SupplierLineScope[]

  @@unique([workspaceId, position])
  @@index([workspaceId])
  @@map("rfq_line_items")
}

model SupplierLineScope {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  supplierUserId String   @map("supplier_user_id") @db.Uuid
  rfqLineItemId  String   @map("rfq_line_item_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rfqLineItem RfqLineItem @relation(fields: [rfqLineItemId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, supplierUserId, rfqLineItemId])
  @@index([workspaceId, supplierUserId])
  @@map("supplier_line_scopes")
}

model RfqAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  fileName      String   @map("file_name")
  fileSizeBytes Int      @map("file_size_bytes")
  mimeType      String   @map("mime_type")
  storageKey    String   @map("storage_key")
  uploadedById  String   @map("uploaded_by_id") @db.Uuid
  version       Int      @default(1)
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  clarificationMessageId String? @map("clarification_message_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clarificationMessage ClarificationMessage? @relation(fields: [clarificationMessageId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([clarificationMessageId])
  @@map("rfq_attachments")
}

model SupplierAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  supplierUserId String    @map("supplier_user_id") @db.Uuid
  assignedById   String    @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  removedAt      DateTime? @map("removed_at")
  removedById    String?   @map("removed_by_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([supplierUserId])
  @@map("supplier_assignments")
}

// ── Real quotations (replaces QuotationPlaceholder) ─────────────────────────
model Quotation {
  id             String          @id @default(uuid()) @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  supplierUserId String          @map("supplier_user_id") @db.Uuid
  total          Decimal         @db.Decimal(18, 4)
  currency       String
  unitPriceAvg   Decimal?        @map("unit_price_avg") @db.Decimal(18, 4)
  leadTimeDays   Int?            @map("lead_time_days")
  moq            Int?
  incoterm       String?
  paymentTerms   String?         @map("payment_terms")
  sampleAvail    Boolean?        @map("sample_avail")
  validUntil     DateTime?       @map("valid_until")
  status         QuotationStatus @default(SUBMITTED)
  submittedAt    DateTime        @default(now()) @map("submitted_at")
  revisedAt      DateTime?       @map("revised_at")
  withdrawnAt    DateTime?       @map("withdrawn_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lineItems QuotationLineItem[]

  @@unique([workspaceId, supplierUserId])
  @@index([workspaceId])
  @@map("quotations")
}

model QuotationLineItem {
  id            String  @id @default(uuid()) @db.Uuid
  quotationId   String  @map("quotation_id") @db.Uuid
  rfqLineItemId String? @map("rfq_line_item_id") @db.Uuid
  position      Int
  description   String  @db.Text
  quantity      Decimal @db.Decimal(18, 4)
  unitPrice     Decimal @map("unit_price") @db.Decimal(18, 4)
  total         Decimal @db.Decimal(18, 4)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_line_items")
}

// ── Clarifications (real read receipts table replaces JSON read_by) ─────────
model ClarificationThread {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  ClarificationMessage[]

  @@map("clarification_threads")
}

model ClarificationMessage {
  id               String                  @id @default(uuid()) @db.Uuid
  threadId         String                  @map("thread_id") @db.Uuid
  authorUserId     String                  @map("author_user_id") @db.Uuid
  parentMessageId  String?                 @map("parent_message_id") @db.Uuid
  body             String                  @db.Text
  visibility       ClarificationVisibility @default(ALL)
  mentionedUserIds String[]                @default([]) @map("mentioned_user_ids") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")

  thread       ClarificationThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  readReceipts ClarificationReadReceipt[]
  attachments  RfqAttachment[]

  @@index([threadId, createdAt])
  @@map("clarification_messages")
}

model ClarificationReadReceipt {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")

  message ClarificationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("clarification_read_receipts")
}

// ── Notifications ───────────────────────────────────────────────────────────
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  role        Role?
  workspaceId String?          @map("workspace_id") @db.Uuid
  eventType   String?          @map("event_type")
  type        NotificationType
  title       String
  message     String
  link        String?
  metadata    Json             @default("{}")
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notifications")
}

// ── WhatsApp Notification Bridge™ ───────────────────────────────────────────
model WhatsAppNotificationDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  notificationId    String    @unique @map("notification_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  workspaceRef      String?   @map("workspace_ref")
  templateKey       String    @map("template_key")
  recipientPhone    String?   @map("recipient_phone")
  provider          String    @default("meta_cloud")
  status            String    @default("QUEUED")
  providerMessageId String?   @map("provider_message_id")
  retryCount        Int       @default(0) @map("retry_count")
  lastError         String?   @map("last_error")
  providerResponse  Json      @default("{}") @map("provider_response")
  queuedAt          DateTime  @default(now()) @map("queued_at")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")
  nextRetryAt       DateTime? @map("next_retry_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@index([userId, queuedAt])
  @@index([providerMessageId])
  @@map("whatsapp_notification_deliveries")
}

// ── Email Notification Bridge™ ────────────────────────────────────────────────
model EmailNotificationDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  notificationId    String    @unique @map("notification_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  workspaceRef      String?   @map("workspace_ref")
  subject           String
  templateKey       String    @map("template_key")
  recipientEmail    String    @map("recipient_email")
  provider          String    @default("smtp")
  status            String    @default("QUEUED")
  providerMessageId String?   @map("provider_message_id")
  retryCount        Int       @default(0) @map("retry_count")
  lastError         String?   @map("last_error")
  providerResponse  Json      @default("{}") @map("provider_response")
  queuedAt          DateTime  @default(now()) @map("queued_at")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  openedAt          DateTime? @map("opened_at")
  nextRetryAt       DateTime? @map("next_retry_at")
  passwordlessTokenId String? @map("passwordless_token_id") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@index([userId, queuedAt])
  @@index([providerMessageId])
  @@index([passwordlessTokenId])
  @@map("email_notification_deliveries")
}

// ── Audit log (defense-in-depth FSM enforcement) ────────────────────────────
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  actorEmail  String   @map("actor_email")
  actorRole   String   @map("actor_role")
  action      String
  fromState   String?  @map("from_state")
  toState     String   @map("to_state")
  reason      String?
  payload     Json     @default("{}")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ── Supplier activity (Sprint 2.5) ──────────────────────────────────────────
model SupplierActivityLog {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  supplierUserId String        @map("supplier_user_id") @db.Uuid
  stage          SupplierStage
  lastActivityAt DateTime      @default(now()) @map("last_activity_at")
  nudgedAt       DateTime?     @map("nudged_at")
  declineReason  String?       @map("decline_reason")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, supplierUserId])
  @@index([workspaceId])
  @@map("supplier_activity_log")
}

// ── Telemetry capture (Sprint 2.5 · no dashboard yet) ───────────────────────
model TelemetryEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  event       String
  workspaceId String?  @map("workspace_id") @db.Uuid
  targetId    String?  @map("target_id")
  meta        Json     @default("{}")
  clientAt    DateTime @map("client_at")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, occurredAt])
  @@index([userId, occurredAt])
  @@index([workspaceId, occurredAt])
  @@map("telemetry_events")
}

// ── CommodityBid (Sprint 3A) ─────────────────────────────────────────────────
model CommodityBidDetails {
  id                     String    @id @default(uuid()) @db.Uuid
  workspaceId            String    @unique @map("workspace_id") @db.Uuid
  title                  String
  productCategory        String?   @map("product_category")
  description            String    @db.Text
  targetMarket           String?   @map("target_market")
  lastRejectionReason    String?   @map("last_rejection_reason")
  lastRejectedAt         DateTime? @map("last_rejected_at")
  auctionStartsAt        DateTime? @map("auction_starts_at")
  auctionEndsAt          DateTime? @map("auction_ends_at")
  auctionDurationMinutes Int?      @map("auction_duration_minutes")
  invitationDeadlineAt   DateTime? @map("invitation_deadline_at")
  auctionRules           Json      @default("{}") @map("auction_rules")
  lowestBidAmount        Decimal?  @map("lowest_bid_amount") @db.Decimal(18, 4)
  lowestBidSupplierId    String?   @map("lowest_bid_supplier_id") @db.Uuid
  winnerSubmissionId     String?   @map("winner_submission_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("commoditybid_details")
}

model CommodityBidLot {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  lotNumber      Int      @map("lot_number")
  commodity      String
  quantity       Decimal  @db.Decimal(18, 4)
  uom            String
  specs          Json     @default("{}")
  incoterms      String?
  deliveryWindow String?  @map("delivery_window")
  notes          String?
  noAwardReason  String?  @map("no_award_reason")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions CommodityBidSubmission[]
  awards      CommodityBidAward[]
  bidEvents   CommodityBidBidEvent[]

  @@unique([workspaceId, lotNumber])
  @@index([workspaceId])
  @@map("commoditybid_lots")
}

model CommodityBidInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  supplierUserId String    @map("supplier_user_id") @db.Uuid
  bidderCode     String    @map("bidder_code")
  invitedById    String    @map("invited_by_id") @db.Uuid
  status         String    @default("INVITED")
  invitedAt      DateTime  @default(now()) @map("invited_at")
  viewedAt       DateTime? @map("viewed_at")
  acceptedAt     DateTime? @map("accepted_at")
  declinedAt     DateTime? @map("declined_at")
  joinedAt       DateTime? @map("joined_at")
  removedAt      DateTime? @map("removed_at")
  removedById    String?   @map("removed_by_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, supplierUserId])
  @@unique([workspaceId, bidderCode])
  @@index([workspaceId])
  @@map("commoditybid_invitations")
}

model CommodityBidBidEvent {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  lotId          String   @map("lot_id") @db.Uuid
  supplierUserId String   @map("supplier_user_id") @db.Uuid
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 4)
  eventType      String   @map("event_type")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lot       CommodityBidLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("commoditybid_bid_events")
}

model CommodityBidSubmission {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  lotId          String    @map("lot_id") @db.Uuid
  supplierUserId String    @map("supplier_user_id") @db.Uuid
  unitPrice      Decimal   @map("unit_price") @db.Decimal(18, 4)
  currency       String
  leadTimeDays   Int?      @map("lead_time_days")
  moq            Int?
  paymentTerms   String?   @map("payment_terms")
  deliveryTerms  String?   @map("delivery_terms")
  validUntil     DateTime  @map("valid_until")
  notes          String?
  withdrawnAt    DateTime? @map("withdrawn_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lot       CommodityBidLot     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  awards    CommodityBidAward[]

  @@unique([lotId, supplierUserId])
  @@index([workspaceId])
  @@index([lotId])
  @@map("commoditybid_submissions")
}

model CommodityBidAward {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  lotId          String    @map("lot_id") @db.Uuid
  supplierUserId String    @map("supplier_user_id") @db.Uuid
  submissionId   String    @map("submission_id") @db.Uuid
  status         String
  awardedAt      DateTime? @map("awarded_at")
  acceptedAt     DateTime? @map("accepted_at")
  declinedAt     DateTime? @map("declined_at")
  declineReason  String?   @map("decline_reason")
  withdrawnAt    DateTime? @map("withdrawn_at")
  withdrawReason String?   @map("withdraw_reason")
  slaDeadlineAt  DateTime? @map("sla_deadline_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lot        CommodityBidLot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  submission CommodityBidSubmission @relation(fields: [submissionId], references: [id])

  @@index([workspaceId])
  @@index([lotId])
  @@index([status, slaDeadlineAt])
  @@map("commoditybid_awards")
}

// ── Order Workspace (Sprint 3B) ─────────────────────────────────────────────
model OrderWorkspace {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @unique @map("workspace_id") @db.Uuid
  contractRef           String    @map("contract_ref")
  currency              String
  totalValue            Decimal   @map("total_value") @db.Decimal(18, 4)
  incoterms             String
  originPort            String    @map("origin_port")
  destinationPort       String    @map("destination_port")
  supplierUserId        String    @map("supplier_user_id") @db.Uuid
  buyerUserId           String    @map("buyer_user_id") @db.Uuid
  parentWorkspaceId     String    @map("parent_workspace_id") @db.Uuid
  parentWorkspaceType   String    @map("parent_workspace_type")
  supplierConfirmedAt   DateTime? @map("supplier_confirmed_at")
  confirmSlaDeadlineAt  DateTime? @map("confirm_sla_deadline_at")
  productionStartedAt   DateTime? @map("production_started_at")
  productionCompletedAt DateTime? @map("production_completed_at")
  productionPlannedAt   DateTime? @map("production_planned_at")
  inspectionRequestedAt DateTime? @map("inspection_requested_at")
  inspectionCompletedAt DateTime? @map("inspection_completed_at")
  inspectionResult      String?   @map("inspection_result")
  inspectionReportUrl   String?   @map("inspection_report_url")
  inspectorName         String?   @map("inspector_name")
  freightForwarder      String?   @map("freight_forwarder")
  vesselName            String?   @map("vessel_name")
  billOfLading          String?   @map("bill_of_lading")
  expectedDeparture     DateTime? @map("expected_departure")
  departedAt            DateTime? @map("departed_at")
  currentEta            DateTime? @map("current_eta")
  arrivedAt             DateTime? @map("arrived_at")
  deliveredAt           DateTime? @map("delivered_at")
  closedAt              DateTime? @map("closed_at")
  disputeOpenedAt       DateTime? @map("dispute_opened_at")
  disputeReason         String?   @map("dispute_reason")
  disputeCategory       String?   @map("dispute_category")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([contractRef])
  @@index([parentWorkspaceId])
  @@map("order_workspaces")
}

model OrderDocument {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  documentType  String   @map("document_type")
  fileName      String   @map("file_name")
  mimeType      String   @map("mime_type")
  storageKey    String   @map("storage_key")
  fileSizeBytes Int      @map("file_size_bytes")
  version       Int      @default(1)
  uploadedById  String   @map("uploaded_by_id") @db.Uuid
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, documentType])
  @@map("order_documents")
}

model OrderStatusUpdate {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  updateType   String    @map("update_type")
  label        String?
  percentage   Int?
  notes        String?
  previousEta  DateTime? @map("previous_eta")
  newEta       DateTime? @map("new_eta")
  deltaDays    Int?      @map("delta_days")
  reason       String?
  reportedById String    @map("reported_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("order_status_updates")
}

// ── Shipment workspace (Sprint 3C) ────────────────────────────────────────────
model ShipmentWorkspace {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @unique @map("workspace_id") @db.Uuid
  orderWorkspaceId      String    @map("order_workspace_id") @db.Uuid
  orderRef              String    @map("order_ref")
  poRef                 String?   @map("po_ref")
  contractRef           String    @map("contract_ref")
  currency              String
  buyerUserId           String    @map("buyer_user_id") @db.Uuid
  supplierUserId        String    @map("supplier_user_id") @db.Uuid
  originPort            String    @map("origin_port")
  destinationPort       String    @map("destination_port")
  referenceNumber       String?   @map("reference_number")
  containerNumber       String?   @map("container_number")
  bookingNumber         String?   @map("booking_number")
  vesselName            String?   @map("vessel_name")
  voyageNumber          String?   @map("voyage_number")
  bookingRef            String?   @map("booking_ref")
  carrierName           String?   @map("carrier_name")
  trackingLinkedAt      DateTime? @map("tracking_linked_at")
  lastTrackingSyncAt    DateTime? @map("last_tracking_sync_at")
  lastTrackingSyncError String?   @map("last_tracking_sync_error")
  bookingConfirmedAt    DateTime? @map("booking_confirmed_at")
  containerAssignedAt   DateTime? @map("container_assigned_at")
  pickedUpAt            DateTime? @map("picked_up_at")
  loadedAt              DateTime? @map("loaded_at")
  departedAt            DateTime? @map("departed_at")
  arrivedAt             DateTime? @map("arrived_at")
  customsStartedAt      DateTime? @map("customs_started_at")
  customsCompletedAt    DateTime? @map("customs_completed_at")
  deliveredAt           DateTime? @map("delivered_at")
  completedAt           DateTime? @map("completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  freightSelections FreightSelection[]

  @@index([orderWorkspaceId])
  @@index([orderRef])
  @@index([trackingLinkedAt])
  @@map("shipment_workspaces")
}

// ── FreightIQ (Sprint 5A — freight coordination) ────────────────────────────
model FreightRequest {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  organizationWorkspaceId String? @map("organization_workspace_id") @db.Uuid
  buyerId          String    @map("buyer_id") @db.Uuid
  supplierId       String    @map("supplier_id") @db.Uuid
  mode             String
  pol              String
  pod              String
  cargoDescription String    @map("cargo_description") @db.Text
  containerType    String?   @map("container_type")
  readyDate        DateTime? @map("ready_date")
  status           String
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  order          Workspace                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offers         FreightOffer[]
  selection      FreightSelection?
  communications FreightRequestCommunication[]

  @@index([orderId])
  @@index([organizationWorkspaceId])
  @@index([status])
  @@index([buyerId])
  @@map("freight_requests")
}

model FreightOffer {
  id                 String    @id @default(uuid()) @db.Uuid
  freightRequestId   String    @map("freight_request_id") @db.Uuid
  providerName       String    @map("provider_name")
  carrierName        String    @map("carrier_name")
  price              Decimal   @db.Decimal(18, 4)
  currency           String
  transitDays        Int       @map("transit_days")
  validUntil         DateTime  @map("valid_until")
  remarks            String?   @db.Text
  status             String    @default("ACTIVE")
  forwarderContactId String?   @map("forwarder_contact_id") @db.Uuid
  offerSource        String?   @map("offer_source")
  vesselName         String?   @map("vessel_name")
  etd                DateTime?
  eta                DateTime?
  cutOff             DateTime? @map("cut_off")
  communicationId    String?   @map("communication_id") @db.Uuid
  internalCostUsd    Decimal?  @map("internal_cost_usd") @db.Decimal(18, 4)
  freightiqMarginUsd Decimal   @default(0) @map("freightiq_margin_usd") @db.Decimal(18, 4)
  displayPriceUsd    Decimal?  @map("display_price_usd") @db.Decimal(18, 4)
  marginLockedAt     DateTime? @map("margin_locked_at")
  marginLockedBy     String?   @map("margin_locked_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  freightRequest   FreightRequest               @relation(fields: [freightRequestId], references: [id], onDelete: Cascade)
  revenueLedger    FreightRevenueLedger[]
  forwarderContact ForwarderContact?            @relation(fields: [forwarderContactId], references: [id], onDelete: SetNull)
  communication    FreightRequestCommunication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  selection        FreightSelection?

  @@index([freightRequestId])
  @@index([status, validUntil])
  @@index([forwarderContactId])
  @@map("freight_offers")
}

model ForwarderContact {
  id          String   @id @default(uuid()) @db.Uuid
  companyName String   @map("company_name")
  contactName String   @map("contact_name")
  email       String
  phone       String?
  country     String?
  notes       String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  communications FreightRequestCommunication[]
  offers         FreightOffer[]

  @@index([active])
  @@index([companyName])
  @@map("forwarder_contacts")
}

/// Ocean carriers / shipping lines used in FreightIQ offer cards (e.g. Yang Ming Line).
model FreightShipper {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  scacCode  String?  @map("scac_code")
  country   String?
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([name])
  @@index([active])
  @@map("freight_shippers")
}

model FreightRequestCommunication {
  id                 String    @id @default(uuid()) @db.Uuid
  freightRequestId   String    @map("freight_request_id") @db.Uuid
  forwarderContactId String    @map("forwarder_contact_id") @db.Uuid
  status             String    @default("PENDING")
  channel            String
  sentAt             DateTime? @map("sent_at")
  respondedAt        DateTime? @map("responded_at")
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")

  freightRequest   FreightRequest   @relation(fields: [freightRequestId], references: [id], onDelete: Cascade)
  forwarderContact ForwarderContact @relation(fields: [forwarderContactId], references: [id], onDelete: Restrict)
  offers           FreightOffer[]

  @@index([freightRequestId])
  @@index([status])
  @@index([forwarderContactId])
  @@map("freight_request_communications")
}

model FreightSelection {
  id                  String   @id @default(uuid()) @db.Uuid
  freightRequestId    String   @unique @map("freight_request_id") @db.Uuid
  offerId             String   @unique @map("offer_id") @db.Uuid
  selectedById        String   @map("selected_by") @db.Uuid
  selectedAt          DateTime @default(now()) @map("selected_at")
  shipmentWorkspaceId String?  @map("shipment_workspace_id") @db.Uuid

  freightRequest FreightRequest     @relation(fields: [freightRequestId], references: [id], onDelete: Cascade)
  offer          FreightOffer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  shipment       ShipmentWorkspace? @relation(fields: [shipmentWorkspaceId], references: [workspaceId], onDelete: SetNull)

  @@index([shipmentWorkspaceId])
  @@map("freight_selections")
}

model FreightEstimate {
  id                     String    @id @default(uuid()) @db.Uuid
  tradeId                String    @map("trade_id") @db.Uuid
  supplierId             String    @map("supplier_id") @db.Uuid
  originCountry          String    @map("origin_country")
  originPort             String    @map("origin_port")
  destinationCountry     String    @map("destination_country")
  destinationPort        String    @map("destination_port")
  containerType          String    @map("container_type")
  fobValue               Decimal   @map("fob_value") @db.Decimal(18, 4)
  estimatedFreight       Decimal   @map("estimated_freight") @db.Decimal(18, 4)
  currency               String
  estimatedCifValue      Decimal   @map("estimated_cif_value") @db.Decimal(18, 4)
  estimatedAt            DateTime  @default(now()) @map("estimated_at")
  expiresAt              DateTime  @map("expires_at")
  lastRefreshedAt        DateTime? @map("last_refreshed_at")
  status                 String    @default("ACTIVE")
  referenceFreightRateId String?   @map("reference_freight_rate_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  trade                Workspace             @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  referenceFreightRate ReferenceFreightRate? @relation(fields: [referenceFreightRateId], references: [id], onDelete: SetNull)

  @@index([tradeId, status])
  @@index([tradeId, estimatedAt])
  @@index([expiresAt, status])
  @@index([referenceFreightRateId])
  @@map("freight_estimates")
}

model ReferenceFreightRate {
  id               String   @id @default(uuid()) @db.Uuid
  originPort       String   @map("origin_port")
  destinationPort  String   @map("destination_port")
  containerType    String   @map("container_type")
  referenceFreight Decimal  @map("reference_freight") @db.Decimal(18, 4)
  currency         String   @default("USD")
  validFrom        DateTime @map("valid_from")
  validUntil       DateTime @map("valid_until")
  status           String   @default("ACTIVE")
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  audits           ReferenceFreightRateAudit[]
  freightEstimates FreightEstimate[]

  @@index([originPort, destinationPort, containerType, validUntil])
  @@index([validFrom, validUntil])
  @@index([status])
  @@map("reference_freight_rates")
}

model ReferenceFreightRateAudit {
  id          String   @id @default(uuid()) @db.Uuid
  rateId      String?  @map("rate_id") @db.Uuid
  action      String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  snapshot    Json
  createdAt   DateTime @default(now()) @map("created_at")

  rate ReferenceFreightRate? @relation(fields: [rateId], references: [id], onDelete: SetNull)

  @@index([rateId, createdAt])
  @@index([createdAt])
  @@map("reference_freight_rate_audits")
}

// Sprint 17B — FreightIQ Booking Engine (planning layer, not shipment execution)
model CargoReadyForecast {
  id                            String   @id @default(uuid()) @db.Uuid
  tradeId                       String   @map("trade_id") @db.Uuid
  supplierId                    String   @map("supplier_id") @db.Uuid
  freightBookingId              String?  @map("freight_booking_id") @db.Uuid
  productionStartDate           DateTime @map("production_start_date")
  estimatedProductionFinishDate DateTime @map("estimated_production_finish_date")
  estimatedCargoReadyDate       DateTime @map("estimated_cargo_ready_date")
  confidenceLevel               String   @map("confidence_level")
  notes                         String?  @db.Text
  status                        String   @default("DRAFT")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  trade          Workspace       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  freightBooking FreightBooking? @relation(fields: [freightBookingId], references: [id], onDelete: SetNull)

  @@index([tradeId, status])
  @@index([freightBookingId])
  @@map("cargo_ready_forecasts")
}

model FreightBooking {
  id                      String    @id @default(uuid()) @db.Uuid
  tradeId                 String    @map("trade_id") @db.Uuid
  supplierId              String    @map("supplier_id") @db.Uuid
