  updatedById         String?   @map("updated_by_id") @db.Uuid
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  shipmentWorkspace ShipmentWorkspace @relation(fields: [shipmentWorkspaceId], references: [id], onDelete: Cascade)

  @@unique([shipmentWorkspaceId, type])
  @@index([shipmentWorkspaceId])
  @@index([shipmentWorkspaceId, status])
  @@index([plannedAt])
  @@index([estimatedAt])
  @@index([status])
  @@map("shipment_milestones")
}

/// SPR-30-01 — multi-container rows under a shipment (FSM still uses primary containerNumber)
model ShipmentContainer {
  id                  String   @id @default(uuid()) @db.Uuid
  shipmentWorkspaceId String   @map("shipment_workspace_id") @db.Uuid
  containerNumber     String   @map("container_number")
  containerType       String?  @map("container_type")
  sealNumber          String?  @map("seal_number")
  grossWeightKg       Decimal? @map("gross_weight_kg") @db.Decimal(14, 3)
  netWeightKg         Decimal? @map("net_weight_kg") @db.Decimal(14, 3)
  volumeCbm           Decimal? @map("volume_cbm") @db.Decimal(14, 3)
  packageCount        Int?     @map("package_count")
  status              String   @default("PLANNED")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  shipmentWorkspace ShipmentWorkspace @relation(fields: [shipmentWorkspaceId], references: [id], onDelete: Cascade)
  lineAllocations   ShipmentLineAllocation[]

  @@index([shipmentWorkspaceId])
  @@index([containerNumber])
  @@map("shipment_containers")
}

/// Sprint 31 — explicit PO ↔ Shipment lineage (supports split / consolidated shipments).
/// Header link only; line qty lives in ShipmentLineAllocation.
/// shipmentWorkspaceId stores SHIPMENT Workspace.id (same convention as API paths).
model TradeShipmentLink {
  id                  String   @id @default(uuid()) @db.Uuid
  purchaseOrderId     String   @map("purchase_order_id") @db.Uuid
  orderWorkspaceId    String   @map("order_workspace_id") @db.Uuid
  shipmentWorkspaceId String   @map("shipment_workspace_id") @db.Uuid
  source              String   @default("DISCOVERED") // DISCOVERED | MANUAL | SPAWN
  createdById         String?  @map("created_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([purchaseOrderId, shipmentWorkspaceId])
  @@index([shipmentWorkspaceId])
  @@index([orderWorkspaceId])
  @@index([purchaseOrderId])
  @@map("trade_shipment_links")
}

/// Sprint 31 — PO line quantity allocated to a shipment (optional container).
model ShipmentLineAllocation {
  id                    String   @id @default(uuid()) @db.Uuid
  purchaseOrderLineId   String   @map("purchase_order_line_id") @db.Uuid
  purchaseOrderId       String   @map("purchase_order_id") @db.Uuid
  shipmentWorkspaceId   String   @map("shipment_workspace_id") @db.Uuid
  shipmentContainerId   String?  @map("shipment_container_id") @db.Uuid
  quantity              Decimal  @db.Decimal(18, 4)
  unit                  String?
  createdById           String?  @map("created_by_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  purchaseOrderLine PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  shipmentContainer ShipmentContainer? @relation(fields: [shipmentContainerId], references: [id], onDelete: SetNull)

