  allocation BcSupplierAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([allocationId])
  @@index([workspaceId])
  @@map("bc_supplier_proformas")
}

model BcPaymentRecord {
  id               String    @id @default(uuid()) @db.Uuid
  allocationId     String    @map("allocation_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  supplierCode     String    @map("supplier_code")
  amount           Decimal   @db.Decimal(18, 4)
  currency         String    @default("USD")
  status           String    @default("PAYMENT_PENDING")
  paymentReference String?   @map("payment_reference")
  confirmedAt      DateTime? @map("confirmed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
