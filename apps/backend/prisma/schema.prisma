  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  catalogProductId   String    @map("catalog_product_id") @db.Uuid
  catalogPackagingId String?   @map("catalog_packaging_id") @db.Uuid
  packingTypeId      String    @map("packing_type_id") @db.Uuid
  palletCount        Int       @map("pallet_count")
  sortOrder          Int       @default(0) @map("sort_order")
  indicativeUnitLow  Decimal?  @map("indicative_unit_low") @db.Decimal(18, 4)
  indicativeUnitMid  Decimal?  @map("indicative_unit_mid") @db.Decimal(18, 4)
  indicativeUnitHigh Decimal?  @map("indicative_unit_high") @db.Decimal(18, 4)
  removedAt          DateTime? @map("removed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

