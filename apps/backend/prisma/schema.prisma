// ── Idempotency keys (frontend axios sends Idempotency-Key on mutations) ────
model IdempotencyKey {
  key        String   @id
  userId     String?  @map("user_id") @db.Uuid
  route      String
  response   Json
  statusCode Int      @map("status_code")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, route])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ── Sprint 18A — Trade Timeline Engine ───────────────────────────────────────
model TradeTimelineEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tradeId       String   @map("trade_id") @db.Uuid
  eventType     String   @map("event_type")
  eventCategory String   @map("event_category")
  title         String
  description   String?  @db.Text
  sourceModule  String   @map("source_module")
  severity      String
  occurredAt    DateTime @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")
  metadata      Json     @default("{}")

  trade Workspace @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId, occurredAt])
  @@index([tradeId, eventType])
  @@map("trade_timeline_events")
}

// ── Faz 1 — processed external/FSM events (dedup) ───────────────────────────
model ProcessedEvent {
  id          String   @id @default(uuid()) @db.Uuid
  source      String
  eventId     String   @map("event_id")
  workspaceId String?  @map("workspace_id") @db.Uuid
  action      String?
  processedAt DateTime @default(now()) @map("processed_at")
  payload     Json?

  @@unique([source, eventId])
  @@index([workspaceId])
  @@map("processed_events")
}

// ── Unified Messaging — transactional outbox + persistent dedup ───────────────
model MessagingOutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  eventType      String    @map("event_type")
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  conversationId String?   @map("conversation_id") @db.Uuid
  messageId      String?   @map("message_id") @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key")
  payload        Json      @default("{}")
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at")
  processedAt    DateTime? @map("processed_at")
  failedAt       DateTime? @map("failed_at")
  lastErrorCode  String?   @map("last_error_code")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([conversationId])
  @@map("messaging_outbox_events")
}

model MessagingIdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String
  keyHash   String   @unique @map("key_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("messaging_idempotency_keys")
}
