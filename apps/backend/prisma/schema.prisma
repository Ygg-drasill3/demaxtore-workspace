// ── Bulk Container (Sprint 13B — catalog + builder MVP) ───────────────────────
model BulkSpecTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  productType String   @map("product_type")
  name        String
  schema      Json
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products BulkCatalogProduct[]

  @@index([productType, isActive])
  @@map("bulk_spec_templates")
}

model BulkCatalogCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products BulkCatalogProduct[]

  @@index([status, sortOrder])
  @@map("bulk_catalog_categories")
}

model BulkCatalogProduct {
  id                 String   @id @default(uuid()) @db.Uuid
  productRef         String   @unique @map("product_ref")
  categoryId         String   @map("category_id") @db.Uuid
  name               String
  standardPacking    String   @map("standard_packing")
  specTemplateId     String   @map("spec_template_id") @db.Uuid
  marketStatus       String   @default("STABLE") @map("market_status")
  indicativeLow      Decimal? @map("indicative_low") @db.Decimal(18, 4)
  indicativeHigh     Decimal? @map("indicative_high") @db.Decimal(18, 4)
  indicativeCurrency String   @default("USD") @map("indicative_currency")
  minOrderMt         Decimal  @default(1) @map("min_order_mt") @db.Decimal(10, 3)
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  category          BulkCatalogCategory  @relation(fields: [categoryId], references: [id])
  specTemplate      BulkSpecTemplate     @relation(fields: [specTemplateId], references: [id])
  lines             BulkContainerLine[]
  procurementQuotes BcProcurementQuote[]

  @@index([categoryId, status])
  @@map("bulk_catalog_products")
}

model BulkContainerDetails {
  id                   String    @id @db.Uuid
  workspaceId          String    @unique @map("workspace_id") @db.Uuid
  maxCapacityMt        Decimal   @default(25) @map("max_capacity_mt") @db.Decimal(10, 3)
  currentWeightMt      Decimal   @default(0) @map("current_weight_mt") @db.Decimal(10, 3)
  destinationMarket    String?   @map("destination_market")
  currency             String    @default("USD")
  estValueMin          Decimal?  @map("est_value_min") @db.Decimal(18, 4)
  estValueMax          Decimal?  @map("est_value_max") @db.Decimal(18, 4)
  submittedAt          DateTime? @map("submitted_at")
  procurementStartedAt DateTime? @map("procurement_started_at")
  activeOfferId        String?   @map("active_offer_id") @db.Uuid
  capacityWarnings     Json      @default("[]") @map("capacity_warnings")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activeOffer BcContainerOffer? @relation("BcActiveOffer", fields: [activeOfferId], references: [id], onDelete: SetNull)

  @@map("bulk_container_details")
}

model BcProcurementQuote {
  id                    String   @id @default(uuid()) @db.Uuid
  workspaceId           String   @map("workspace_id") @db.Uuid
  lineId                String   @map("line_id") @db.Uuid
  supplierCode          String   @map("supplier_code")
  productId             String   @map("product_id") @db.Uuid
  packingTypeId         String   @map("packing_type_id") @db.Uuid
  specificationSnapshot Json     @default("{}") @map("specification_snapshot")
  quantityMt            Decimal  @map("quantity_mt") @db.Decimal(10, 3)
  unitPrice             Decimal  @map("unit_price") @db.Decimal(18, 4)
  currency              String   @default("USD")
  notes                 String?
  createdById           String   @map("created_by_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  line        BulkContainerLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  product     BulkCatalogProduct @relation(fields: [productId], references: [id])
  packingType PackingType        @relation(fields: [packingTypeId], references: [id])

  @@unique([workspaceId, lineId])
  @@index([workspaceId])
  @@map("bc_procurement_quotes")
}

model BcContainerOffer {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  offerReference String    @unique @map("offer_reference")
  version        Int       @default(1)
  status         String    @default("DRAFT")
  offerTotal     Decimal   @map("offer_total") @db.Decimal(18, 4)
  currency       String    @default("USD")
  validUntil     DateTime  @map("valid_until")
  offerNotes     String?   @map("offer_notes")
  sentAt         DateTime? @map("sent_at")
  viewedAt       DateTime? @map("viewed_at")
  approvedAt     DateTime? @map("approved_at")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines            BcOfferLine[]
  revisions        BcRevisionRequest[]
  activeForDetails BulkContainerDetails[] @relation("BcActiveOffer")

  @@index([workspaceId, status])
  @@map("bc_container_offers")
}

model BcOfferLine {
  id                   String  @id @default(uuid()) @db.Uuid
  offerId              String  @map("offer_id") @db.Uuid
  lineId               String  @map("line_id") @db.Uuid
  productName          String  @map("product_name")
  packingType          String  @map("packing_type")
  specificationSummary String  @map("specification_summary")
  quantityMt           Decimal @map("quantity_mt") @db.Decimal(10, 3)
  unitPrice            Decimal @map("unit_price") @db.Decimal(18, 4)
  lineTotal            Decimal @map("line_total") @db.Decimal(18, 4)

  offer BcContainerOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  line  BulkContainerLine @relation(fields: [lineId], references: [id])

  @@index([offerId])
  @@map("bc_offer_lines")
}

model BcRevisionRequest {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  offerId     String   @map("offer_id") @db.Uuid
  message     String
  status      String   @default("OPEN")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  offer     BcContainerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("bc_revision_requests")
}

model BcSupplierAllocation {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  lineId              String   @map("line_id") @db.Uuid
  supplierCode        String   @map("supplier_code")
  allocatedQuantityMt Decimal  @map("allocated_quantity_mt") @db.Decimal(10, 3)
  allocationStatus    String   @default("ASSIGNED") @map("allocation_status")
  sortOrder           Int      @default(0) @map("sort_order")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  line      BulkContainerLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  proformas BcSupplierProforma[]
  payments  BcPaymentRecord[]
  orderLink BcOrderLink?

  @@index([workspaceId])
  @@index([lineId])
  @@index([workspaceId, allocationStatus])
  @@map("bc_supplier_allocations")
}

model BcMasterOrder {
  id              String   @id @default(uuid()) @db.Uuid
  bulkContainerId String   @map("bulk_container_id") @db.Uuid
  externalRef     String   @unique @map("external_ref")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bulkContainer Workspace     @relation(fields: [bulkContainerId], references: [id], onDelete: Cascade)
  orderLinks    BcOrderLink[]

  @@index([bulkContainerId])
  @@map("bc_master_orders")
}

model BcOrderLink {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  masterOrderId   String   @map("master_order_id") @db.Uuid
  supplierOrderId String   @map("supplier_order_id") @db.Uuid
  allocationId    String   @unique @map("allocation_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  bulkContainer Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  masterOrder   BcMasterOrder        @relation(fields: [masterOrderId], references: [id], onDelete: Cascade)
  supplierOrder Workspace            @relation("BcSupplierOrderLink", fields: [supplierOrderId], references: [id], onDelete: Cascade)
  allocation    BcSupplierAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([masterOrderId])
  @@index([supplierOrderId])
  @@map("bc_order_links")
}

model BcSupplierProforma {
  id              String   @id @default(uuid()) @db.Uuid
  allocationId    String   @map("allocation_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  supplierCode    String   @map("supplier_code")
