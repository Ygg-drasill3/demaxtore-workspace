// ── SPR-30-08 — Operational Configuration (metadata only; future ops behavior) ─
model OperationalSettings {
  id                          String   @id @default(uuid()) @db.Uuid
  /// Optimistic locking / config version (increments on every save)
  version                     Int      @default(1)
  riskAtRiskMinutes           Int      @default(1) @map("risk_at_risk_minutes")
  riskDelayedMinutes          Int      @default(1440) @map("risk_delayed_minutes")
  defaultEtaBufferHours       Int      @default(24) @map("default_eta_buffer_hours")
  defaultIssueSeverity        String   @default("MEDIUM") @map("default_issue_severity")
  defaultTaskPriority         String   @default("MEDIUM") @map("default_task_priority")
  completionDocsRequired      Boolean  @default(false) @map("completion_docs_required")
  updatedById                 String?  @map("updated_by_id") @db.Uuid
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("operational_settings")
}

model OperationalAutomationRule {
  id          String    @id @default(uuid()) @db.Uuid
  /// Stable event key, e.g. inspection.failed
  key         String    @unique
  name        String
  description String?   @db.Text
  enabled     Boolean   @default(true)
  priority    Int       @default(100)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@map("operational_automation_rules")
}

model OperationalTaskTemplate {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  category             String    @default("GENERAL")
  priority             String    @default("MEDIUM")
  defaultAssigneeRole  String?   @map("default_assignee_role")
  dueOffsetDays        Int       @default(3) @map("due_offset_days")
  /// Links to automation rule key or task automation key (e.g. upload_bill_of_lading)
  automationTrigger    String?   @map("automation_trigger")
  description          String?   @db.Text
  enabled              Boolean   @default(true)
  version              Int       @default(1)
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([enabled])
  @@index([automationTrigger])
  @@map("operational_task_templates")
}

model OperationalMilestoneTemplate {
  id                String    @id @default(uuid()) @db.Uuid
  /// ShipmentMilestoneType value
  type              String
  name              String
  sequence          Int
  defaultOffsetDays Int       @default(0) @map("default_offset_days")
  enabled           Boolean   @default(true)
  required          Boolean   @default(true)
  skipByDefault     Boolean   @default(false) @map("skip_by_default")
  version           Int       @default(1)
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([type])
  @@index([enabled, sequence])
  @@map("operational_milestone_templates")
}

model OperationalConfigAudit {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email")
  actorRole   String?  @map("actor_role")
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("operational_config_audits")
}
