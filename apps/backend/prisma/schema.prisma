/// SPR-30-05 — Operational Issues (business exceptions; independent of FSM / Tasks)
model OperationalIssue {
  id                     String    @id @default(uuid()) @db.Uuid
  orderId                String    @map("order_id") @db.Uuid
  relatedEntityType      String?   @map("related_entity_type")
  relatedEntityId        String?   @map("related_entity_id") @db.Uuid
  category               String
  severity               String    @default("MEDIUM")
  status                 String    @default("OPEN")
  title                  String
  description            String?   @db.Text
  assignedTaskId         String?   @map("assigned_task_id") @db.Uuid
  reportedById           String    @map("reported_by_id") @db.Uuid
  resolvedById           String?   @map("resolved_by_id") @db.Uuid
  resolvedAt             DateTime? @map("resolved_at")
  closedById             String?   @map("closed_by_id") @db.Uuid
  closedAt               DateTime? @map("closed_at")
  resolutionNote         String?   @map("resolution_note") @db.Text
  resolutionSuggestedAt  DateTime? @map("resolution_suggested_at")
  automationKey          String?   @map("automation_key")
  /// Sprint 34 — Exception Intelligence metadata (nullable = historical)
  impactType             String?   @map("impact_type")
  ownerRole              String?   @map("owner_role")
  recommendedAction      String?   @map("recommended_action") @db.Text
  sourceEventType        String?   @map("source_event_type")
  sourceRuleId           String?   @map("source_rule_id")
  sourceAlertId          String?   @map("source_alert_id") @db.Uuid
  deletedAt              DateTime? @map("deleted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([orderId, status])
  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([relatedEntityType, relatedEntityId])
  @@index([assignedTaskId])
  @@index([impactType])
