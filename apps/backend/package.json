{
  "name": "@dmx/backend",
  "version": "0.2.0",
  "private": true,
  "description": "DeMaxtore backend — Express + Prisma + PostgreSQL + Socket.io",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ../../scripts/generate-build-info.mjs && yarn workspace @dmx/contracts build && node scripts/emit-dist.mjs --strict",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/commoditybid.sealed-bid.test.ts' --exclude '**/commoditybid.scheduler.test.ts'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "demo:seed": "tsx prisma/seed-demo.ts",
    "demo:reset": "tsx prisma/reset-demo.ts",
    "setup:production": "tsx prisma/setup-production.ts",
    "prisma:studio": "prisma studio",
    "logos:fetch-missing": "tsx scripts/fetch-missing-supplier-logos.ts",
    "logos:fetch-missing:dry": "DRY_RUN=1 tsx scripts/fetch-missing-supplier-logos.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@dmx/contracts": "*",
    "@prisma/client": "^5.18.0",
    "@sentry/node": "^10.60.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.13.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "redis": "^4.7.0",
    "resend": "^6.12.4",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.18.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
